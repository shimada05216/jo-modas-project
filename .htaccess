# Jo Modas - configuracao do Apache

Options -Indexes
AddDefaultCharset UTF-8

# Os arquivos .js e .css tem texto acentuado voltado ao cliente.
# Sem o charset declarado, alguns servidores entregam sem codificacao
# e o navegador exibe "PeÃ§as" no lugar de "Peças".
<IfModule mod_mime.c>
    AddCharset UTF-8 .js .css
</IfModule>

<IfModule mod_dir.c>
    DirectoryIndex index.php index.html
</IfModule>

# Bloqueia o acesso direto a arquivos que nao devem ser servidos
<FilesMatch "\.(sql|md|log|ini|example\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Bloqueia arquivos ocultos (.git, .env, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
